### Task 8: JWT Authentication Request
@baseUrl = http://localhost:8080/api/v1

### 1. Authenticate to obtain JWT token
// @no-cookie-jar
POST {{baseUrl}}/auth/authenticate
Content-Type: application/json

{
  "email": "john@mail.com",
  "password": "password"
}

> {%
    client.test("Authentication returns 200 and JWT token", function() {
        client.assert(response.status === 200, "Expected 200 OK");
        client.assert(response.body.length > 20, "JWT token should not be empty");
        client.global.set("jwtToken", response.body);
    });
%}
