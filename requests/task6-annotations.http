### Task 6: Annotations Security Test Suite (10 Requests)
@baseUrl = http://localhost:8080/api/v1
@adminAuth = Basic YWRtaW46YWRtaW4xMjM=
@managerAuth = Basic bWFuYWdlcjptYW5hZ2VyMTIz
@userAuth = Basic dXNlcjp1c2VyMTIz

### 1. Anonymous Access on @PreAuthorize Route (Expect: 401 Unauthorized)
// @no-cookie-jar
GET {{baseUrl}}/documents/secret-vault
Accept: application/json

> {%
    client.test("Anonymous rejected on annotated route (401)", function() {
        client.assert(response.status === 401, "Expected 401 Unauthorized");
    });
%}

### 2. User Role on @PreAuthorize("hasRole('ADMIN')") Vault (Expect: 403 Forbidden)
// @no-cookie-jar
GET {{baseUrl}}/documents/secret-vault
Authorization: {{userAuth}}
Accept: application/json

> {%
    client.test("User role forbidden by @PreAuthorize (403)", function() {
        client.assert(response.status === 403, "Expected 403 Forbidden");
    });
%}

### 3. Manager Role on @PreAuthorize("hasRole('ADMIN')") Vault (Expect: 403 Forbidden)
// @no-cookie-jar
GET {{baseUrl}}/documents/secret-vault
Authorization: {{managerAuth}}
Accept: application/json

> {%
    client.test("Manager role forbidden by @PreAuthorize (403)", function() {
        client.assert(response.status === 403, "Expected 403 Forbidden");
    });
%}

### 4. Admin Role on @PreAuthorize("hasRole('ADMIN')") Vault (Expect: 200 OK)
// @no-cookie-jar
GET {{baseUrl}}/documents/secret-vault
Authorization: {{adminAuth}}
Accept: application/json

> {%
    client.test("Admin role allowed by @PreAuthorize (200)", function() {
        client.assert(response.status === 200, "Expected 200 OK");
    });
%}

### 5. User Role on @PreAuthorize("hasAnyRole('MANAGER', 'ADMIN')") (Expect: 403 Forbidden)
// @no-cookie-jar
GET {{baseUrl}}/documents/management-overview
Authorization: {{userAuth}}
Accept: application/json

> {%
    client.test("User role denied management overview (403)", function() {
        client.assert(response.status === 403, "Expected 403 Forbidden");
    });
%}

