### 9. User Role Create Attempt on @PreAuthorize("hasAnyRole('MANAGER', 'ADMIN')") (Expect: 403 Forbidden)
// @no-cookie-jar
POST {{baseUrl}}/documents
Authorization: {{userAuth}}
Content-Type: application/json

{
  "title": "Blocked User Document",
  "description": "Attempt to create document without role",
  "classificationLevel": "INTERNAL",
  "department": "Security",
  "tags": ["test"]
}

> {%
    client.test("User role create blocked by annotation (403)", function() {
        client.assert(response.status === 403, "Expected 403 Forbidden");
    });
%}

### 10. Manager Role Delete Attempt on @PreAuthorize("hasRole('ADMIN')") (Expect: 403 Forbidden)
// @no-cookie-jar
DELETE {{baseUrl}}/documents/non-existent-id
Authorization: {{managerAuth}}

> {%
    client.test("Manager delete blocked by @PreAuthorize (403)", function() {
        client.assert(response.status === 403, "Expected 403 Forbidden");
    });
%}
