### DocuShield - Task 4: CSRF & Audit 5 CRUD Requests
@baseUrl = http://localhost:8080/api/v1
@adminAuth = Basic YWRtaW46YWRtaW4xMjM=

### 1. Show all items
GET {{baseUrl}}/documents
Authorization: {{adminAuth}}
Accept: application/json

> {%
    client.test("Status code is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 2. Create one item
POST {{baseUrl}}/documents
Authorization: {{adminAuth}}
Content-Type: application/json

{
  "title": "Data Loss Prevention Policy",
  "description": "Rules and guidelines for protecting restricted data",
  "classificationLevel": "SECRET",
  "department": "InfoSec",
  "tags": ["dlp", "compliance"]
}

> {%
    client.test("Status code is 201", function() {
        client.assert(response.status === 201, "Response status is not 201");
        client.global.set("activeDocId", response.body.id);
    });
%}

### 3. Read one item
GET {{baseUrl}}/documents/{{activeDocId}}
Authorization: {{adminAuth}}
Accept: application/json

> {%
    client.test("Status code is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 4. Update one item
PUT {{baseUrl}}/documents/{{activeDocId}}
Authorization: {{adminAuth}}
Content-Type: application/json

{
  "title": "Data Loss Prevention Policy - Revised",
  "description": "Updated guidelines after internal review",
  "classificationLevel": "SECRET",
  "department": "InfoSec",
  "tags": ["dlp", "revised"]
}

> {%
    client.test("Status code is 200", function() {
        client.assert(response.status === 200, "Response status is not 200");
    });
%}

### 5. Delete one item
DELETE {{baseUrl}}/documents/{{activeDocId}}
Authorization: {{adminAuth}}

> {%
    client.test("Status code is 200 or 204", function() {
        client.assert(response.status === 200 || response.status === 204, "Response status is not 200/204");
    });
%}
