{
  "info": {
    "name": "DocuShield API (Labs 1-4)",
    "description": "Postman test suite for DocuShield Web Security Labs 1 to 4",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Task 1 & 2 - Public Info",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/public/info",
          "host": ["{{baseUrl}}"],
          "path": ["public", "info"]
        }
      }
    },
    {
      "name": "Task 3 - 01. Anonymous Read (Expect 401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents",
          "host": ["{{baseUrl}}"],
          "path": ["documents"]
        }
      }
    },
    {
      "name": "Task 3 - 02. Invalid Auth (Expect 401)",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "invalid", "type": "string" },
            { "key": "password", "value": "badpass", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents",
          "host": ["{{baseUrl}}"],
          "path": ["documents"]
        }
      }
    },
    {
      "name": "Task 3 & 4 - 03. Read All Documents (User Auth)",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "user", "type": "string" },
            { "key": "password", "value": "user123", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents",
          "host": ["{{baseUrl}}"],
          "path": ["documents"]
        }
      }
    },
    {
      "name": "Task 3 & 4 - 04. Create Document (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.id) { pm.environment.set('documentId', jsonData.id); }"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "user", "type": "string" },
            { "key": "password", "value": "user123", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Network Topology Assessment\",\n  \"description\": \"Internal diagram of cloud microservices\",\n  \"classificationLevel\": \"CONFIDENTIAL\",\n  \"department\": \"Infrastructure\",\n  \"tags\": [\"network\", \"cloud\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/documents",
          "host": ["{{baseUrl}}"],
          "path": ["documents"]
        }
      }
    },
    {
      "name": "Task 3 & 4 - 05. Read Document By ID",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "user", "type": "string" },
            { "key": "password", "value": "user123", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["documents", "{{documentId}}"]
        }
      }
    },
    {
      "name": "Task 3 & 4 - 06. Update Document (PUT)",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "user", "type": "string" },
            { "key": "password", "value": "user123", "type": "string" }
          ]
        },
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Network Topology Assessment v2\",\n  \"description\": \"Updated with zero trust subnet rules\",\n  \"classificationLevel\": \"CONFIDENTIAL\",\n  \"department\": \"Infrastructure\",\n  \"tags\": [\"network\", \"cloud\", \"updated\"]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["documents", "{{documentId}}"]
        }
      }
    },
    {
      "name": "Task 3 - 07. Forbidden Delete by Regular User (Expect 403)",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "user", "type": "string" },
            { "key": "password", "value": "user123", "type": "string" }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["documents", "{{documentId}}"]
        }
      }
    },
    {
      "name": "Task 3 & 4 - 08. Delete Document by Admin (DELETE 204)",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "admin", "type": "string" },
            { "key": "password", "value": "admin123", "type": "string" }
          ]
        },
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/documents/{{documentId}}",
          "host": ["{{baseUrl}}"],
          "path": ["documents", "{{documentId}}"]
        }
      }
    },
    {
      "name": "Task 4 - 09. Get CSRF Token",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/csrf",
          "host": ["{{baseUrl}}"],
          "path": ["csrf"]
        }
      }
    },
    {
      "name": "Task 4 - 10. Audit Logs List (Admin Only)",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "admin", "type": "string" },
            { "key": "password", "value": "admin123", "type": "string" }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/audit-logs",
          "host": ["{{baseUrl}}"],
          "path": ["audit-logs"]
        }
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    },
    {
      "key": "documentId",
      "value": ""
    }
  ]
}
